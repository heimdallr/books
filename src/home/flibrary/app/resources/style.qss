* {
  font-family: "IBM Plex Sans";
  font-size: 12pt;
  letter-spacing: 0px;
}

QMainWindow,
QDialog {
  background-color: palette(window);
  color: palette(window-text);
}

QWidget#topBar {
  min-height: 48px;
  max-height: 48px;
  background-color: palette(base);
  border-bottom: 1px solid palette(mid);
}

QWidget#leftWidget,
QWidget[navigationPane="true"] {
  background-color: palette(base);
}

QWidget#leftWidget {
  border-right: 1px solid palette(mid);
}

QWidget#rightWidget,
QWidget#booksWidget {
  background-color: palette(window);
}

QWidget#annotationWidget,
QFrame#AuthorAnnotationWidget {
  background-color: palette(base);
}

QLineEdit,
QComboBox,
QAbstractSpinBox {
  min-height: 36px;
  padding: 0 12px;
  background-color: palette(base);
  color: palette(text);
  border: 1px solid palette(mid);
  border-radius: 8px;
  selection-background-color: palette(highlight);
  selection-color: palette(highlighted-text);
}

QLineEdit#lineEditBookTitleToSearch {
  min-height: 36px;
  background-color: palette(window);
  border-radius: 9px;
}

QLineEdit#lineEditBookTitleToSearch QToolButton,
QLineEdit#value QToolButton {
  min-width: 20px;
  max-width: 20px;
  min-height: 20px;
  max-height: 20px;
  padding: 0;
  margin: 0;
  background-color: transparent;
  border: 0;
}

QToolButton#themeToggle {
  min-width: 36px;
  max-width: 36px;
  min-height: 36px;
  max-height: 36px;
}

QLineEdit:hover,
QComboBox:hover,
QAbstractSpinBox:hover {
  border-color: palette(dark);
}

QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus {
  border: 2px solid palette(highlight);
}

QLineEdit:disabled,
QComboBox:disabled,
QAbstractSpinBox:disabled {
  background-color: palette(alternate-base);
  color: palette(placeholder-text);
}

QLineEdit[errorTag="true"] {
  border: 2px solid palette(bright-text);
}

QLineEdit[errorTag="false"] {
  border: 1px solid palette(mid);
}

QComboBox {
  padding-right: 28px;
}

QComboBox::drop-down {
  width: 26px;
  border: 0;
}

QComboBox#cbValueMode::drop-down {
  width: 0;
}

QComboBox#cbValueMode::down-arrow {
  image: none;
}

QComboBox#cbMode,
QComboBox#cbMode:hover,
QComboBox#cbMode:focus {
  min-height: 30px;
  padding: 0 26px 0 4px;
  background-color: transparent;
  border: 0;
  border-radius: 8px;
  font-weight: 600;
}

QComboBox#cbMode:hover {
  background-color: palette(alternate-base);
}

QWidget#booksModeToggle {
  min-height: 34px;
  max-height: 34px;
  background-color: palette(base);
  border: 1px solid palette(mid);
  border-radius: 8px;
}

QWidget#booksModeToggle QToolButton {
  min-width: 70px;
  min-height: 32px;
  max-height: 32px;
  padding: 0 12px;
  color: palette(text);
  background-color: transparent;
  border: 0;
  border-radius: 7px;
  font-weight: 500;
}

QWidget#booksModeToggle QToolButton[segmentPosition="first"] {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right: 1px solid palette(mid);
}

QWidget#booksModeToggle QToolButton[segmentPosition="last"] {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

QWidget#booksModeToggle QToolButton:hover {
  background-color: palette(alternate-base);
}

QWidget#booksModeToggle QToolButton:checked {
  color: palette(highlighted-text);
  background-color: palette(highlight);
  font-weight: 600;
}

QPushButton {
  min-height: 32px;
  padding: 0 15px;
  background-color: palette(button);
  color: palette(button-text);
  border: 1px solid palette(mid);
  border-radius: 8px;
  font-weight: 500;
}

QPushButton:hover {
  border-color: palette(dark);
}

QPushButton:pressed,
QPushButton:checked {
  background-color: palette(midlight);
}

QPushButton:default {
  background-color: palette(highlight);
  color: palette(highlighted-text);
  border-color: palette(highlight);
}

QPushButton:disabled {
  color: palette(placeholder-text);
  border-color: palette(mid);
}

QToolButton {
  min-width: 28px;
  min-height: 28px;
  padding: 2px;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
}

QToolButton:hover {
  background-color: palette(alternate-base);
  border-color: palette(mid);
}

QToolButton:pressed,
QToolButton:checked {
  background-color: palette(midlight);
}

QMenuBar {
  spacing: 2px;
  background-color: palette(base);
}

QMenuBar::item {
  padding: 6px 10px;
  background-color: transparent;
  border-radius: 6px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
  background-color: palette(alternate-base);
}

QMenu {
  padding: 6px;
  background-color: palette(base);
  color: palette(text);
  border: 1px solid palette(mid);
  border-radius: 8px;
  menu-scrollable: 1;
}

QMenu::item {
  min-height: 22px;
  padding: 4px 28px 4px 10px;
  border-radius: 5px;
}

QMenu::item:selected {
  background-color: palette(highlight);
  color: palette(highlighted-text);
}

QMenu::item:disabled {
  color: palette(placeholder-text);
}

QMenu::separator {
  height: 1px;
  margin: 5px 8px;
  background-color: palette(mid);
}

QTreeView,
QTableView,
QListView {
  background-color: palette(window);
  alternate-background-color: palette(alternate-base);
  color: palette(text);
  border: 0;
  outline: 0;
  show-decoration-selected: 1;
  selection-background-color: palette(highlight);
  selection-color: palette(highlighted-text);
  font-size: 12pt;
}

QTreeView[navigationPane="true"] {
  background-color: palette(base);
  border-top: 1px solid palette(mid);
}

QTreeView[navigationPane="true"]::item {
  min-height: 38px;
  padding: 5px 12px;
  font-size: 12pt;
}

QTreeView[navigationPane="true"]::item:selected {
  padding-left: 9px;
  border-left: 3px solid palette(highlight);
}

QWidget[navigationPane="true"] QComboBox#cbMode,
QWidget[navigationPane="true"] QComboBox#cbMode:hover,
QWidget[navigationPane="true"] QComboBox#cbMode:focus {
  min-height: 36px;
  padding-left: 0;
  font-size: 14pt;
  font-weight: 600;
}

QWidget[navigationPane="true"] QLineEdit#value {
  min-height: 36px;
  background-color: palette(window);
}

QWidget[navigationPane="true"] QLabel#lblCount {
  min-width: 22px;
  padding: 2px 7px;
  background-color: palette(alternate-base);
  border-radius: 8px;
  font-size: 10pt;
}

QTreeView::item,
QTableView::item,
QListView::item {
  min-height: 34px;
  padding: 4px 8px;
  border: 0;
}

QHeaderView {
  background-color: palette(alternate-base);
  border: 0;
}

QHeaderView::section {
  min-height: 38px;
  padding: 5px 10px;
  background-color: palette(alternate-base);
  color: palette(placeholder-text);
  border: 0;
  border-right: 1px solid palette(mid);
  border-bottom: 1px solid palette(mid);
  font-size: 12pt;
  font-weight: 600;
}

QHeaderView::section:hover {
  color: palette(text);
}

QTextEdit,
QPlainTextEdit,
QTextBrowser {
  padding: 8px;
  background-color: palette(base);
  color: palette(text);
  border: 1px solid palette(mid);
  border-radius: 8px;
  selection-background-color: palette(highlight);
  selection-color: palette(highlighted-text);
}

QGroupBox {
  margin-top: 15px;
  padding: 13px 12px 10px;
  background-color: transparent;
  border: 1px solid palette(mid);
  border-radius: 8px;
  font-weight: 600;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 5px;
}

QTabWidget::pane {
  background-color: palette(base);
  border: 1px solid palette(mid);
  border-radius: 8px;
}

QTabBar::tab {
  min-height: 28px;
  padding: 3px 13px;
  background-color: palette(window);
  border: 1px solid palette(mid);
  border-bottom: 0;
}

QTabBar::tab:selected {
  background-color: palette(base);
}

QCheckBox,
QRadioButton {
  spacing: 8px;
}

QSplitter::handle {
  background-color: palette(mid);
}

QSplitter::handle:horizontal {
  width: 1px;
}

QSplitter::handle:vertical {
  height: 1px;
}

QSplitter::handle:hover {
  background-color: palette(highlight);
}

QScrollBar:vertical {
  width: 10px;
  margin: 0;
  background: transparent;
}

QScrollBar:horizontal {
  height: 10px;
  margin: 0;
  background: transparent;
}

QScrollBar::handle {
  min-width: 24px;
  min-height: 24px;
  margin: 2px;
  background-color: palette(mid);
  border-radius: 4px;
}

QScrollBar::handle:hover {
  background-color: palette(dark);
}

QScrollBar::add-line,
QScrollBar::sub-line {
  width: 0;
  height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: transparent;
}

QProgressBar {
  min-height: 8px;
  text-align: center;
  background-color: palette(midlight);
  border: 0;
  border-radius: 4px;
}

QProgressBar::chunk {
  background-color: palette(highlight);
  border-radius: 4px;
}

QStatusBar {
  background-color: palette(base);
  color: palette(placeholder-text);
  border-top: 1px solid palette(mid);
}

QStatusBar::item {
  border: 0;
}

QFrame#mainWidget,
QFrame#AuthorAnnotationWidget,
QTreeView#content {
  border: 0;
}

QLabel#bookTitle {
  padding: 0;
  color: palette(text);
  font-size: 16pt;
  font-weight: 600;
}

QLabel#bookSubtitle {
  padding: 0 0 8px 0;
  color: palette(placeholder-text);
  font-size: 12pt;
}

QLabel#info {
  padding: 0;
  font-size: 12pt;
}

QLabel#lblError {
  color: palette(bright-text);
}

QWidget#categoryPane {
  background-color: palette(alternate-base);
  border-right: 1px solid palette(mid);
}

QListWidget#categories {
  background-color: transparent;
  border: 0;
  outline: 0;
  font-size: 12pt;
  font-weight: 500;
}

QListWidget#categories::item {
  min-height: 30px;
  padding: 3px 10px;
  border-radius: 8px;
}

QListWidget#categories::item:hover {
  background-color: palette(midlight);
}

QListWidget#categories::item:selected {
  color: palette(text);
}

QStackedWidget#pages,
QWidget#settingsContent {
  background-color: palette(base);
}

QWidget#settingsFooter {
  background-color: palette(alternate-base);
  border-top: 1px solid palette(mid);
}

QLabel#settingsPageTitle {
  font-size: 14pt;
  font-weight: 600;
}

QLabel#versionLabel {
  font-family: "IBM Plex Mono";
  font-size: 9pt;
}

QGroupBox[settingsGroup="true"] {
  margin-top: 16px;
  padding-top: 12px;
  background-color: palette(alternate-base);
  border: 1px solid palette(mid);
  border-radius: 8px;
}

QGroupBox[settingsGroup="true"]::title {
  color: palette(placeholder-text);
  font-size: 10pt;
  font-weight: 600;
}

QWidget[settingsRow="true"] {
  min-height: 34px;
  background-color: transparent;
}

QTreeView#view {
  background-color: palette(alternate-base);
  border: 1px solid palette(mid);
  border-radius: 8px;
}

QLabel#lblCount {
  min-height: 20px;
  padding: 0 7px;
  background-color: palette(alternate-base);
  color: palette(placeholder-text);
  border-radius: 10px;
  font-family: "IBM Plex Mono";
  font-size: 10pt;
}

QWidget#annotationWidget {
  border-top: 1px solid palette(mid);
}

QScrollArea#coverArea,
QScrollArea#scrollArea,
QScrollArea#coverArea > QWidget > QWidget,
QScrollArea#scrollArea > QWidget > QWidget,
QLabel#cover {
  background-color: transparent;
  border: 0;
}

QWidget#contentWidget {
  background-color: palette(base);
  border-left: 1px solid palette(mid);
}

QTreeView#content {
  background-color: palette(base);
  font-size: 11pt;
}

QTreeView#content::item {
  min-height: 30px;
  padding: 4px 10px;
}

QTreeView#content QHeaderView::section {
  min-height: 36px;
  padding: 0 14px;
  background-color: palette(base);
  border-right: 0;
  font-size: 11pt;
  font-weight: 600;
}
