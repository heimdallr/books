From d89bc8e80e19980b6bf5eccb14d5f1da3dce9e8d Mon Sep 17 00:00:00 2001
From: heimdallr <heimdalrnsk@gmail.com>
Date: Mon, 14 Sep 2026 15:13:11 +0700
Subject: [PATCH] patch sqlite3

---
 sqlite3.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/sqlite3.c b/sqlite3.c
index 0644a39f..8864a690 100644
--- a/sqlite3.c
+++ b/sqlite3.c
@@ -212554,6 +212554,8 @@ static int remove_diacritic(int c, int bComplex){
     'e',       'e'|HIBIT, 'e'|HIBIT, 'i',       'o',       'o'|HIBIT,
     'o'|HIBIT, 'o'|HIBIT, 'u',       'u'|HIBIT, 'u'|HIBIT, 'y',
   };
+  if (c == 1105)
+    c = 1077;
 
   unsigned int key = (((unsigned int)c)<<3) | 0x00000007;
   int iRes = 0;
@@ -267415,6 +267417,8 @@ static int fts5_remove_diacritic(int c, int bComplex){
     'e',       'e'|HIBIT, 'e'|HIBIT, 'i',       'o',       'o'|HIBIT,
     'o'|HIBIT, 'o'|HIBIT, 'u',       'u'|HIBIT, 'u'|HIBIT, 'y',
   };
+  if (c == 1105)
+    c = 1077;
 
   unsigned int key = (((unsigned int)c)<<3) | 0x00000007;
   int iRes = 0;
