#ifndef __cpp_lib_format

#include <filesystem>
#include <string>
#include <string_view>
#include <type_traits>
#include <utility>

#include <fmt/format.h>
#include <fmt/std.h>

class QString;

namespace flibrary_compat
{
template <typename T>
decltype(auto) FormatArgument(T&& value)
{
	if constexpr (std::is_same_v<std::remove_cvref_t<T>, QString>)
		return std::forward<T>(value).toStdString();
	else
		return std::forward<T>(value);
}
}

namespace std
{
using format_args = fmt::format_args;
using format_context = fmt::format_context;

template <typename T, typename Char = char>
struct formatter : fmt::formatter<T, Char>
{
};

template <typename... Args>
auto make_format_args(Args&... args)
{
	return fmt::make_format_args(args...);
}

inline string vformat(string_view pattern, fmt::format_args args)
{
	return fmt::vformat(fmt::string_view(pattern.data(), pattern.size()), args);
}

template <typename... Args>
string format(string_view pattern, Args&&... args)
{
	return fmt::format(
		fmt::runtime(fmt::string_view(pattern.data(), pattern.size())),
		flibrary_compat::FormatArgument(std::forward<Args>(args))...
	);
}
}

#endif
