# Из чего собирать: тег релиза https://github.com/heimdallr/books (можно указать и ветку, например master).
BOOKS_REF='Release/2/2.7.3'

# Версия QT, исопльзуемая при сборке проекта. Сейчас для релизного тега 'Release/2/2.7.3' захаркожена 6.12.0 в build.sh, поэтому используем ее
QT_VERIOSN='6.12.0'

# Папка с архивами книг и файлом .inpx
LIBRARY_DIR='<path_to_ipnx with content>'

# Папка с дополнительными данными (необязательно);
# Там ожидаются, если примонтирована:
# * reviews/*.7z - архивы с отзывами читателей на книги.
# * reviews/additional.zip - внутри books.json с оценками книг (используется, если в настройках включён уточнённый рейтинг).
# * authors/ - архивы со сведениями об авторах.
# * compilations.7z - описание сборников, читается при создании коллекции.
# * annotations.7z - аннотации книг, тоже читаются при создании коллекции.
# Скорее всего $LIBRARY_DIR+'/etc'
ADDITIONAL_DIR='<path_to_additional/etc_content>'

# Порт запуска библиотеки, если хочется отличный от стандартного
#OPDS_PORT='12791'
